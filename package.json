{
  "name": "surjikal-homepage",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "lint": "oxfmt --check . && oxlint --deny-warnings && stylelint \"src/**/*.css\"",
    "lint:fix": "oxfmt . && oxlint --fix && stylelint --fix \"src/**/*.css\"",
    "format": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "commitlint": "commitlint --edit",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "hono": "4.13.22"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@total-typescript/ts-reset": "0.6.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-ssr-components": "0.8.0",
    "wrangler": "4.168.0"
  }
}
